{
  "name": "llm-release-gate",
  "version": "0.1.0",
  "private": true,
  "description": "Detect prompt regressions before deploy: Promptfoo eval + business-rule checks + a release gate.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval": "promptfoo eval -c promptfooconfig.yaml --no-cache",
    "gate": "tsx src/run.ts",
    "demo:regression": "tsx src/demo.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "promptfoo": "^0.123.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.2",
    "zod": "^4.1.0"
  }
}
